# ── LLM Backend ──
# Opciones: "flm" | "ollama"
METATRON_LLM_BACKEND=flm

# ── FLM Settings ──
FLM_BASE_URL=http://localhost:8000/v1
FLM_API_KEY=dummy
FLM_MODEL=qwen3.5:4b
FLM_TIMEOUT=600
FLM_CTX_LEN=16384

# ── Ollama Settings ──
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=metatron-qwen
OLLAMA_TIMEOUT=600

# ── Database ──
METATRON_DB_HOST=localhost
METATRON_DB_PORT=3306
METATRON_DB_USER=metatron
METATRON_DB_PASS=metatron123
METATRON_DB_NAME=metatron

# ── System Prompt ──
METATRON_SYSTEM_PROMPT=config/system_prompt.txt
